# Vanterm statik site — Apache (cPanel)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType font/woff2 .woff2
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS ve www'suz tek adres (vanterm.com ve demo.vanterm.com için ortak)
# HTTPS-BASLA (deploy/hedef.conf içinde HTTPS="hayir" ise dağıtım bu bloğu çıkarır)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# HTTPS-BITIR

# WebP destekleyen tarayıcılara aynı adresten WebP sürümü (görsel.jpg -> görsel.jpg.webp varsa)
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME}.webp -f
RewriteRule ^(.+\.(?:jpe?g|png))$ $1.webp [T=image/webp,E=VTWEBP:1,L]

# Eski WordPress arama adresleri -> statik arama
RewriteCond %{QUERY_STRING} (^|&)s=
RewriteRule ^$ /search/ [L,R=302]
RewriteCond %{QUERY_STRING} (^|&)s=
RewriteRule ^tr/?$ /tr/search/ [L,R=302]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^search/([^/]+)/?$ /search/?s=$1 [L,R=302,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^tr/search/([^/]+)/?$ /tr/search/?s=$1 [L,R=302,NE]

# Site haritası kısayolu
RewriteRule ^sitemap\.xml$ /sitemap_index.xml [L,R=301]

# WordPress'ten kalan adresler
RewriteRule ^(.*/)?feed/?$ /$1 [L,R=301]
RewriteRule ^(.*/)?amp/?$ /$1 [L,R=301]
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) - [F,L]
RewriteRule ^(.+/)page/1/?$ /$1 [L,R=301]
RewriteRule ^(tr/)?author/ /$1 [L,R=301]
RewriteRule ^(tr/)?[0-9]{4}/([0-9]{2}/)?$ /$1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tr/product/(.+)$ /tr/urun/$1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tr/application/(.+)$ /tr/uygulama-tr/$1 [L,R=301]

# Orijinal sitedeki tekil 301 yönlendirmeleri (build.py üretir: tools/redirects.json)
# YONLENDIRMELER-BASLA
RewriteRule ^2019/09/?$ / [L,R=301]
RewriteRule ^2019/10/?$ / [L,R=301]
RewriteRule ^2020/03/?$ / [L,R=301]
RewriteRule ^application/?$ /applications/ [L,R=301]
RewriteRule ^author/gurere/?$ / [L,R=301]
RewriteRule ^product/?$ /products/ [L,R=301]
RewriteRule ^tr/2019/10/?$ /tr/ [L,R=301]
RewriteRule ^tr/2020/03/?$ /tr/ [L,R=301]
RewriteRule ^tr/application/cnc\-isleme\-merkezi\-icin\-filtre\-cozumu/?$ /tr/uygulama-tr/cnc-isleme-merkezi-icin-filtre-cozumu/ [L,R=301]
RewriteRule ^tr/application/cnc\-plazma\-profil\-kesim\-hatlari\-icin\-filtre\-cozumu/?$ /tr/uygulama-tr/cnc-plazma-profil-kesim-hatlari-icin-filtre-cozumu/ [L,R=301]
RewriteRule ^tr/application/dokumhane\-uygulamasi/?$ /tr/uygulama-tr/dokumhane-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/dusuk\-kapasiteli\-capak\-alma\-makinasi\-filtrasyonu/?$ /tr/uygulama-tr/dusuk-kapasiteli-capak-alma-makinasi-filtrasyonu/ [L,R=301]
RewriteRule ^tr/application/esnek\-emis\-kolu\-ve\-uzatma\-konsolu\-uygulamasi/?$ /tr/uygulama-tr/esnek-emis-kolu-ve-uzatma-konsolu-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/fason\-imalat\-sektorunde\-lazer\-kesim\-filtrasyonu/?$ /tr/uygulama-tr/fason-imalat-sektorunde-lazer-kesim-filtrasyonu/ [L,R=301]
RewriteRule ^tr/application/grafit\-isleme\-makinalari/?$ /tr/uygulama-tr/grafit-isleme-makinalari/ [L,R=301]
RewriteRule ^tr/application/koike\-marka\-lazer\-kesim\-makinasi\-filtrasyonu/?$ /tr/uygulama-tr/koike-marka-lazer-kesim-makinasi-filtrasyonu/ [L,R=301]
RewriteRule ^tr/application/kompozit\-malzeme\-isleme\-hattinda\-tozsuzlastirma/?$ /tr/uygulama-tr/kompozit-malzeme-isleme-hattinda-tozsuzlastirma/ [L,R=301]
RewriteRule ^tr/application/kuru\-tozlarin\-mixer\-karisim\-uygulamasi/?$ /tr/uygulama-tr/kuru-tozlarin-mixer-karisim-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/lazer\-kesim\-makinalari\-atolye\-cozumu/?$ /tr/uygulama-tr/lazer-kesim-makinalari-atolye-cozumu/ [L,R=301]
RewriteRule ^tr/application/marangozhanede\-toz\-toplama\-uygulamasi/?$ /tr/uygulama-tr/marangozhanede-toz-toplama-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/mercedes\-fabrikasinda\-toz\-toplama\-uygulamasi/?$ /tr/uygulama-tr/mercedes-fabrikasinda-toz-toplama-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/merkezi\-filtre\-unitesi\-zimpara\-ve\-taslama\-uygulamasi/?$ /tr/uygulama-tr/merkezi-filtre-unitesi-zimpara-ve-taslama-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/merkezi\-toz\-toplama\-ile\-filtrasyon\-uygulamasi/?$ /tr/uygulama-tr/merkezi-toz-toplama-ile-filtrasyon-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/mobil\-filtre\-unitesi\-ile\-filtrasyon/?$ /tr/uygulama-tr/mobil-filtre-unitesi-ile-filtrasyon/ [L,R=301]
RewriteRule ^tr/application/otomatik\-ahsap\-isleme\-merkezi/?$ /tr/uygulama-tr/otomatik-ahsap-isleme-merkezi/ [L,R=301]
RewriteRule ^tr/application/otomatik\-capak\-alma\-makinasi\-filtrasyonu/?$ /tr/uygulama-tr/otomatik-capak-alma-makinasi-filtrasyonu/ [L,R=301]
RewriteRule ^tr/application/plastik\-parcalarda\-kumlama\-prosesi\-filtrasyonu/?$ /tr/uygulama-tr/plastik-parcalarda-kumlama-prosesi-filtrasyonu/ [L,R=301]
RewriteRule ^tr/application/plastik\-ve\-bakir\-parca\-isleme\-atolyeleri/?$ /tr/uygulama-tr/plastik-ve-bakir-parca-isleme-atolyeleri/ [L,R=301]
RewriteRule ^tr/application/push\-pull\-sistem\-ile\-kaynakhane\-havalandirmasi/?$ /tr/uygulama-tr/push-pull-sistem-ile-kaynakhane-havalandirmasi/ [L,R=301]
RewriteRule ^tr/application/robotik\-lazer\-kaynagi\-filtrasyon\-cozumu/?$ /tr/uygulama-tr/robotik-lazer-kaynagi-filtrasyon-cozumu/ [L,R=301]
RewriteRule ^tr/application/tam\-otomatik\-kontinu\-kumlama\-kabini\-uygulamasi/?$ /tr/uygulama-tr/tam-otomatik-kontinu-kumlama-kabini-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/taslama\-zimpara\-proseslerinde\-filtrasyon\-cozumu/?$ /tr/uygulama-tr/taslama-zimpara-proseslerinde-filtrasyon-cozumu/ [L,R=301]
RewriteRule ^tr/application/tekstil\-sanayinde\-ram\-bacalari\-filtrasyon\-cozumu/?$ /tr/uygulama-tr/tekstil-sanayinde-ram-bacalari-filtrasyon-cozumu/ [L,R=301]
RewriteRule ^tr/application/toz\-sorunu\-olan\-lazer\-kesim\-makinasi\-uygulamasi/?$ /tr/uygulama-tr/toz-sorunu-olan-lazer-kesim-makinasi-uygulamasi/ [L,R=301]
RewriteRule ^tr/application/turbin\-bakiminda\-olusan\-koku\-sorunu\-cozumu/?$ /tr/uygulama-tr/turbin-bakiminda-olusan-koku-sorunu-cozumu/ [L,R=301]
RewriteRule ^tr/author/gurere/?$ /tr/ [L,R=301]
RewriteRule ^tr/pm\-mobil\-filtre\-uniteleri/?$ /tr/urun/pm-mobil-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/privacy\-policy/?$ /tr/gizlilik-bildirimi/ [L,R=301]
RewriteRule ^tr/product/ac\-filtre\-uniteleri/?$ /tr/urun/ac-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/bg\-mobil\-filtre\-uniteleri/?$ /tr/urun/bg-mobil-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/eco\-mobil\-filtre\-uniteleri/?$ /tr/urun/eco-mobil-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/ek\-esnek\-emis\-kollari/?$ /tr/urun/ek-esnek-emis-kollari/ [L,R=301]
RewriteRule ^tr/product/esp\-600\-elektrostatik\-filtre\-unitesi/?$ /tr/urun/esp-600-elektrostatik-filtre-unitesi/ [L,R=301]
RewriteRule ^tr/product/fan\-kabinleri/?$ /tr/urun/fan-kabinleri/ [L,R=301]
RewriteRule ^tr/product/hv\-filtre\-uniteleri/?$ /tr/urun/hv-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/kab\-filtre\-uniteleri/?$ /tr/urun/kab-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/kab\-vortex\-filtre\-uniteleri/?$ /tr/urun/kab-vortex-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/kesme\-masalari/?$ /tr/urun/kesme-masalari/ [L,R=301]
RewriteRule ^tr/product/ko\-uzatma\-konsollari/?$ /tr/urun/ko-uzatma-konsollari/ [L,R=301]
RewriteRule ^tr/product/ktm\-calisma\-masalari/?$ /tr/urun/ktm-calisma-masalari/ [L,R=301]
RewriteRule ^tr/product/m\-mobil\-filtre\-uniteleri/?$ /tr/urun/m-mobil-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/md\-moduler\-davlumbaz/?$ /tr/urun/md-moduler-davlumbaz/ [L,R=301]
RewriteRule ^tr/product/oem\-filtre\-uniteleri/?$ /tr/urun/oem-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/pc\-02\-precoating\-unitesi/?$ /tr/urun/pc-02-precoating-unitesi/ [L,R=301]
RewriteRule ^tr/product/pl\-plazma\-lazer\-filtre\-uniteleri/?$ /tr/urun/pl-plazma-lazer-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/sm\-filtre\-uniteleri/?$ /tr/urun/sm-filtre-uniteleri/ [L,R=301]
RewriteRule ^tr/product/sulu\-on\-filtre/?$ /tr/urun/sulu-on-filtre/ [L,R=301]
RewriteRule ^tr/product/t\-serisi\-calisma\-masalari/?$ /tr/urun/t-serisi-calisma-masalari/ [L,R=301]
RewriteRule ^tr/product/vr\-duvara\-montaj\-fanlar/?$ /tr/urun/vr-duvara-montaj-fanlar/ [L,R=301]
RewriteRule ^tr/urun/?$ /tr/urunler/ [L,R=301]
RewriteRule ^tr/uygulama\-tr/?$ /tr/uygulamalar/ [L,R=301]
# YONLENDIRMELER-BITIR

# Sondaki eğik çizgi (WordPress ile aynı adres biçimi)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# Form ayar dosyasına doğrudan erişim yok
<Files "form-ayarlar.php">
  Require all denied
</Files>

# Hassas dosyalara erişim yok (php.ini, .user.ini, gizli dosyalar, log/yedek/arşiv)
<FilesMatch "(^\.|^php\.ini$|\.(ini|log|sql|bak|old|orig|swp|zip|tar|gz|rar|7z|sh|py|md|yml|yaml|env|conf)$)">
  Require all denied
</FilesMatch>

# Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml font/ttf application/vnd.ms-fontobject
</IfModule>

# Tarayıcı önbelleği
# Sayfalar (HTML) 10 dk taze; sonra 1 gün boyunca önce eldeki kopya gösterilip arkada sessizce yenilenir.
# CSS/JS/font dosyalarının adı ya da ?v= etiketi içerik değişince değiştiği için 1 yıl ve "immutable".
# Görseller 1 yıl: bir görsel değişecekse dosya adı da değiştirilmeli.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=600, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header append Vary Accept env=REDIRECT_VTWEBP
  Header append Vary Accept env=VTWEBP
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Siteyi başka sitelerin içine gömme (clickjacking) engeli
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  # Tarayıcıya yalnızca HTTPS kullanmasını söyle (HTTP isteklerinde tarayıcı bu başlığı yok sayar)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Kamera, mikrofon, konum gibi izinler kapalı
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header unset X-Powered-By
</IfModule>
